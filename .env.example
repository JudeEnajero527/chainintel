# Copy this file to .env and fill in what you have. Everything is optional —
# features without a key show a "needs setup" message instead of breaking.
# .env is git-ignored, so your keys never get committed.

# Whale alerts + gas prices. Free: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Reliable Reddit data (without these, ChainIntel falls back to Reddit's rate-limited RSS feed).
# Create a "script" app at https://www.reddit.com/prefs/apps — the id is under the app name.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Daily digest email (send_digest.py)
CHAININTEL_EMAIL=
CHAININTEL_APP_PASS=
CHAININTEL_URL=http://localhost:8501

# Public contact address shown in the Terms of Use and Privacy Policy (use a dedicated inbox, not a personal one)
CHAININTEL_CONTACT_EMAIL=

# Telegram push alerts — create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=

# Hosting only: a Postgres connection string (leave empty to use the local SQLite file)
DATABASE_URL=
